# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
.env
.env.*

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / dashboard build tooling
node_modules/
dashboard/.vite/

# Runtime data
*.db
data/
logs/

# Local config (keep the example)
loom.yaml

# Homelab/local environment + deploy files (keep *.example) — these carry
# internal topology (hostnames, network names) even though they hold no
# credentials; the public repo ships only the generic compose/config path
.env
.env.*
!.env.homelab.example
docker-compose.homelab.yml
loom.homelab.yaml
loom.homelab.yaml.*
graphify-out/
.deploy-log.jsonl

# Editor/OS backup and sidecar files — these can carry copies of gitignored
# config (e.g. loom.homelab.yaml.pre-*) or macOS metadata (._*) that would
# otherwise slip into this public repo unnoticed
._*
.DS_Store

# Backups of the (already ignored) homelab compose file
docker-compose.homelab.yml.*
